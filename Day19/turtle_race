from turtle import Turtle, Screen
import random

colors = ["red", "orange", "yellow", "green", "blue", "purple"]
y_cords = [-80, -50, -20, 10, 40, 70]
all_turtle = []
screen = Screen()
screen.setup(width=500, height=400)
user_bet = screen.textinput("Turtle Race", "Which turtle will win the race? Enter a color ")

for i in range(0, 6):
    new_turtle = Turtle(shape="turtle")
    new_turtle.pu()
    new_turtle.color(colors[i])
    new_turtle.goto(x= -230,  y= y_cords[i])
    all_turtle.append(new_turtle)

game_start = False

if user_bet:
    game_start = True

while game_start:
    for turtle in all_turtle:
        move_length = random.randint(0, 10)
        turtle.forward(move_length)
        
        if turtle.xcor() > 230:
            winning_color = turtle.pencolor()
            game_start = False
            if user_bet.lower() == turtle.pencolor().lower():
                print(f"You won! The {winning_color} turtle is the winner!")
            else:
                print(f"You lose! The {winning_color} turtle is the winner!")

screen.exitonclick()