tim = Turtle()

def draw_circle(circle_diameter):
    """
    Draws circle and fills with random color
    """
    color = random.sample(color_list, k=1)
    r = color[0][0]
    g = color[0][1]
    b = color[0][2]
    tim.pd()
    tim.fillcolor(r, g, b)
    tim.begin_fill()
    tim.circle(circle_diameter)
    tim.end_fill()

def draw_hirst(amount_of_circles, space, spot_diameter):
    """
    :param amount_of_circles: this is the amount of circles you want arranged virtically and horizontally
    :param space: space between circles
    :param circle_radius: diameter of circle
    """
    tim.hideturtle()
    start_cord = (amount_of_circles * (space - 1)) / 2
    tim.speed("fastest")
    x_cord = -start_cord
    y_cord = -start_cord
    tim.pu()
    tim.goto(x_cord, y_cord)

    while y_cord < start_cord:
        # draw_circle(circle_diameter)
        tim.dot(spot_diameter, random.choice(color_list))
        x_cord += space
        if x_cord > start_cord:
            x_cord = -start_cord
            y_cord += space
        tim.goto(x_cord, y_cord)


draw_hirst(50, 10, 5)

